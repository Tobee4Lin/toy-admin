# ============================================
# Toy Admin Dashboard - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=development

# --- JWT Authentication ---
# CHANGE THIS in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- Database (SQLite) ---
# SQLite database file path (relative to project root)
DB_PATH=./data/app.db

# --- Logger ---
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# --- Frontend Sync (optional) ---
# 前台项目 src/data 目录的绝对或相对路径，用于"同步到前台"功能
# 不设置时默认使用 ../toy-website-next/src/data
# FRONTEND_DATA_DIR=../toy-website-next/src/data
